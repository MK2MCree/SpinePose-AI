MINDSPINE_ENV=production
MINDSPINE_DATA_DIR=/data
MINDSPINE_SESSION_SECRET=replace-with-at-least-32-random-characters
MINDSPINE_PROXY_SECRET=replace-with-a-separate-long-random-secret
MINDSPINE_ALLOWED_ORIGINS=https://your-sites-domain.example
MINDSPINE_TRUSTED_HOSTS=api.your-domain.example
MINDSPINE_COOKIE_SECURE=true
MINDSPINE_SESSION_TTL_SECONDS=28800
MINDSPINE_MAX_UPLOAD_MB=64
MINDSPINE_MAX_BATCH_FILES=100
MINDSPINE_BATCH_WORKERS=2
MINDSPINE_EXPOSE_DOCS=false
MINDSPINE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# Optional AI-enhanced personal reports
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SEC=75
# Local source launch (set in PyCharm Run Configuration; .env is not auto-loaded).
MINDSPINE_HOST=127.0.0.1
MINDSPINE_PORT=8000
# Optional overrides for the existing isolated V2.0.1 source engine:
# MINDSPINE_GAIT_SOURCE_ROOT=C:\path\to\ScoNetVideoApp
# MINDSPINE_GAIT_PYTHON=C:\path\to\ScoNetVideoApp\.build_gpu_venv\Scripts\python.exe
