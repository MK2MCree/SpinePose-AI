{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindSpine curated source summary v1",
  "type": "object",
  "required": [
    "id",
    "title",
    "publisher",
    "source_url",
    "source_date_kind",
    "source_type",
    "evidence_type",
    "evidence_level",
    "summary",
    "applicability",
    "limitations",
    "retrieval_method",
    "source_license",
    "license_note",
    "source_date",
    "retrieved_at",
    "topics",
    "populations",
    "audiences",
    "usage",
    "keywords",
    "key_points",
    "clinical_questions",
    "evidence_kind",
    "access_mode",
    "full_text_indexed",
    "clinically_signed_off"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source_date_kind": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_method": {
      "type": "string",
      "minLength": 1
    },
    "source_license": {
      "type": "string",
      "minLength": 1
    },
    "license_note": {
      "type": "string",
      "minLength": 1
    },
    "source_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
    },
    "source_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "populations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "all",
          "child",
          "adolescent",
          "adult",
          "older_adult"
        ]
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "doctor",
          "family"
        ]
      }
    },
    "usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "education",
          "clinical_reference",
          "research_reference"
        ]
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "key_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clinical_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_kind": {
      "const": "knowledge"
    },
    "access_mode": {
      "const": "summary_only"
    },
    "full_text_indexed": {
      "const": false
    },
    "clinically_signed_off": {
      "const": false
    }
  },
  "additionalProperties": true
}
